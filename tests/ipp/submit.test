# ipptool -f FILE -d copies=1 URI tests/ipp/submit.test
{
  NAME "Submit raster through IPP"
  OPERATION Print-Job
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR name requesting-user-name local-test
  ATTR mimeMediaType document-format image/pwg-raster
  GROUP job-attributes-tag
  ATTR integer copies $copies
  ATTR keyword media iso_a4_210x297mm
  ATTR keyword sides one-sided
  ATTR resolution printer-resolution 600dpi
  FILE $filename
  STATUS successful-ok
  EXPECT job-id DEFINE-VALUE job_id
}
{
  NAME "Raster job completes"
  OPERATION Get-Job-Attributes
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR integer job-id $job_id
  STATUS successful-ok
  EXPECT job-state WITH-VALUE 9 REPEAT-NO-MATCH REPEAT-LIMIT 10
}
